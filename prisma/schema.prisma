generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model User {
  id        String   @id @default(cuid()) @db.VarChar(30)
  auth0Id   String   @unique               @db.VarChar(128)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Event {
  id                String      @id @default(cuid()) @db.VarChar(30)
  title             String      @db.VarChar(200)
  description       String?     @db.VarChar(5000)
  startAt           DateTime
  endAt             DateTime?
  venueName         String?     @db.VarChar(200)
  address           String?     @db.VarChar(500)
  categoryId        String?     @db.VarChar(30)
  ticketPrice       Decimal?    @db.Decimal(10, 2)
  externalTicketUrl String?     @db.VarChar(2048)
  status            EventStatus @default(DRAFT)
  organizerId       String?     @db.VarChar(30)
  deletedAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@map("events")
}
