# PostgreSQL connection string (REQUIRED — validated at startup)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/exkuala_dev?schema=public"

# Application port (REQUIRED — validated at startup, 1-65535)
PORT=3000

# Node environment (optional — controls Swagger UI exposure; defaults to undefined)
# NODE_ENV=development

# Auth0 (Phase 2 — not validated in Phase 1)
# AUTH0_JWKS_URI=
# AUTH0_AUDIENCE=
# AUTH0_ISSUER=
# AUTH0_NAMESPACE=https://exkuala.app
