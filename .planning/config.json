{
  "git": {
    "quick_branch_template": null,
    "branching_strategy": "none"
  },
  "hooks": {
    "context_warnings": true,
    "workflow_guard": true
  },
  "workflow": {
    "research": true,
    "research_before_questions": true,
    "plan_check": true,
    "skip_discuss": false,
    "ai_integration_phase": true,
    "text_mode": false,
    "ui_safety_gate": false,
    "auto_advance": false,
    "use_worktrees": false,
    "verifier": true,
    "nyquist_validation": true,
    "ui_phase": false,
    "pattern_mapper": true,
    "tdd_mode": false,
    "code_review": true,
    "code_review_depth": "quick",
    "ui_review": false
  },
  "commit_docs": true,
  "model_profile": "budget",
  "intel": {
    "enabled": true
  },
  "graphify": {
    "enabled": true
  }
}
